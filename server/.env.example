PORT=8080
LOG_LEVEL=info

# shared key the sideloaded app sends as x-api-key
API_KEY=change-me

# private blob holding <username>.alarms
AZURE_STORAGE_CONNECTION_STRING=
ALARMS_CONTAINER=alarms

# oanda (token never ships in the app)
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice
OANDA_ACCOUNT_ID=

# firebase service account json, raw or base64
FIREBASE_SERVICE_ACCOUNT=

# weekend shutdown
MARKET_TIME_ZONE=UTC
MARKET_OFF_DAYS=0,6

QUIET_WINDOW_MS=120000

